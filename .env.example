# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. NEVER expose to the client. Used for alert/snapshot writes,
# admin user provisioning, reminders and audit logging.
SUPABASE_SECRET_KEY=sb_secret_...

# Legacy key names are also accepted as fallbacks:
# NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY

# Public site origin (used in password-reset redirect)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret for the reminders endpoint: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=change-me-long-random-string

# Local hour after which a missing morning check-in triggers a reminder
MORNING_REMINDER_HOUR=10

# Web Push (Phase 9, flag 'push'). Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:coach@example.com

# AI coach (feature flag 'ai'). Any OpenAI-compatible endpoint works:
#
#   OpenRouter (default): AI_BASE_URL=https://openrouter.ai/api/v1
#     free models share a ~50 req/day account quota
#   NVIDIA NIM:           AI_BASE_URL=https://integrate.api.nvidia.com/v1
#     free ~40 RPM / ~1000 calls-month, key at build.nvidia.com
#     models: nvidia/nemotron-3-ultra-550b-a55b, google/gemma-4-31b-it, ...
#   Google AI Studio:     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     free tier per-model (e.g. gemma-4-31b-it: thousands req/day)
#
AI_API_KEY=sk-or-...
# AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# AI_FALLBACK_MODEL=                          # second model, same provider, tried on failure
# AI_BASE_URL=https://openrouter.ai/api/v1
# Secret for the daily analysis endpoint: Authorization: Bearer <AI_CRON_SECRET>
# AI_CRON_SECRET=change-me-long-random-string
