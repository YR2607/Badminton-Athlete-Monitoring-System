# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. NEVER expose to the client. Used for alert/snapshot writes,
# admin user provisioning, reminders and audit logging.
SUPABASE_SECRET_KEY=sb_secret_...

# Legacy key names are also accepted as fallbacks:
# NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY

# Public site origin (used in password-reset redirect)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret for the reminders endpoint: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=change-me-long-random-string

# Local hour after which a missing morning check-in triggers a reminder
MORNING_REMINDER_HOUR=10

# Web Push (Phase 9, flag 'push'). Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:coach@example.com
