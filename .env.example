# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. NEVER expose to the client. Used for alert/snapshot writes,
# admin user provisioning, reminders and audit logging.
SUPABASE_SECRET_KEY=sb_secret_...

# Legacy key names are also accepted as fallbacks:
# NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY

# Public site origin (used in password-reset redirect)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret for the reminders endpoint: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=change-me-long-random-string

# Local hour after which a missing morning check-in triggers a reminder
MORNING_REMINDER_HOUR=10

# Web Push (Phase 9, flag 'push'). Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:coach@example.com

# AI coach (feature flag 'ai').
#
# Provider selection (AI_PROVIDER):
#   openai   — official OpenAI Responses API (default)
#              AI_BASE_URL=https://api.openai.com/v1, key = OPENAI_API_KEY/AI_API_KEY
#   chat     — any OpenAI-compatible chat/completions endpoint (OpenRouter, NIM…)
#              AI_BASE_URL=https://openrouter.ai/api/v1, key = AI_API_KEY
#
# Model priority: AI_MODELS="model-a,model-b" (comma-separated, tried in order
# on 429/5xx/timeout) or legacy AI_MODEL + AI_FALLBACK_MODEL.
# OPENAI_API_KEY / AI_API_KEY — server-side only, never NEXT_PUBLIC_*
OPENAI_API_KEY=sk-...
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-6-luna
# AI_MODELS=gpt-6-luna,gpt-5.4-mini        # optional explicit priority list
# AI_TIMEOUT_MS=90000                       # per-attempt timeout
# AI_TOTAL_TIMEOUT_MS=300000                # strict deadline across all models
# AI_REASONING_EFFORT=low                   # cap hidden reasoning tokens
# AI_EXTRA_BODY=                            # JSON merged into request body
# AI_DISABLE_RESPONSE_FORMAT=true           # escape hatch: no strict json_schema
# AI_DISABLE_CACHE=true                     # escape hatch: no result cache
# Secret for the daily analysis endpoint: Authorization: Bearer <AI_CRON_SECRET>
# AI_CRON_SECRET=change-me-long-random-string
